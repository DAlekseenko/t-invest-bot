# Runtime mode. effective_mode remains disabled until all live safety gates exist.
APP_ENV=development
TRADING_MODE=disabled
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Addresses inside the trader container.
HTTP_ADDR=0.0.0.0:8080
METRICS_ADDR=0.0.0.0:9090

# Host bindings. Keep loopback addresses for local development.
HTTP_PUBLISH_HOST=127.0.0.1
HTTP_PUBLISH_PORT=8080
METRICS_PUBLISH_HOST=127.0.0.1
METRICS_PUBLISH_PORT=9090

# PostgreSQL connection. make infra-init replaces the marker in the local ignored .env.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=ladder_trader
DATABASE_USER=ladder_trader
DATABASE_PASSWORD=GENERATED_BY_MAKE_INFRA_INIT
